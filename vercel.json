{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/((?!api/|_next/|_vercel/|images/|files/|\\.well-known(?:/|$)|robots\\.txt$|sitemap\\.xml$|llms\\.txt$|favicon\\.ico$).*)",
      "continue": true,
      "transforms": [
        {
          "type": "response.headers",
          "op": "append",
          "target": {"key": "vary"},
          "args": "Accept, Accept-Encoding"
        }
      ]
    }
  ]
}
